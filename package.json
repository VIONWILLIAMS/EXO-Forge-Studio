    "assets:repair": "node scripts/assets.mjs --repair"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.185.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "0.2.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "4.1.11"
  },
  "type": "module",
  "description": "A bilingual 3D exoskeleton concept workbench with procedural motion, CAD assets and articulated robot hands.",
